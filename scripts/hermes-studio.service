[Unit]
Description=Hermes Studio backend (private, loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matteo
Group=matteo
WorkingDirectory=/opt/hermes/hermes-studio/backend
EnvironmentFile=-/etc/hermes/hermes-studio.env
Environment=HERMES_STUDIO_DATA=/var/lib/hermes-studio
Environment=HERMES_STUDIO_HOST=127.0.0.1
Environment=HERMES_STUDIO_PORT=8650
ExecStartPre=/usr/bin/install -d -o matteo -g matteo -m 0700 /var/lib/hermes-studio
# Best-effort nel sandbox (la dir viene creata sul host al deploy); il '-' ignora fallimenti.
ExecStartPre=-/usr/bin/install -d -o matteo -g matteo -m 0700 /home/matteo/.hermes/hermes-studio-in
ExecStart=/opt/hermes/hermes-studio/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8650
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
# read-only (non true): con true i ReadWritePaths sotto /home non vengono
# applicati dal sandbox e la staging fallisce (verificato). Così /home è
# leggibile ma non scrivibile, tranne i path whitelisted sotto.
ProtectHome=read-only
ReadWritePaths=/var/lib/hermes-studio
# Staging input video per il manager (root fidata ~/.hermes): scrivibile
# nonostante ProtectHome (ReadWritePaths ha precedenza).
ReadWritePaths=/home/matteo/.hermes/hermes-studio-in
# NON abilitare/avviare senza OK esplicito dell'utente.

[Install]
WantedBy=multi-user.target
