# Hermes Studio backend — copiare in .env / EnvironmentFile systemd. Mai committare valori reali.
HERMES_STUDIO_DATA=/var/lib/hermes-studio
HERMES_STUDIO_HOST=127.0.0.1
HERMES_STUDIO_PORT=8650
# Se impostato, usa questo invece di bearer.token (rotation via file: cancellare bearer.token e riavviare).
# HERMES_STUDIO_BEARER=
HERMES_STUDIO_COMFY_URL=http://127.0.0.1:8188
HERMES_STUDIO_MANAGER_URL=http://127.0.0.1:8643
# OBBLIGATORIA per submit/coda: senza, il manager risponde 401 e i job falliscono.
# Prendere la app-key da /etc/hermes/keys/app.key (ruolo app, mai full-control).
# HERMES_STUDIO_MANAGER_KEY=
HERMES_STUDIO_MAX_UPLOAD_MB=25
